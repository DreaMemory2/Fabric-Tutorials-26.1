{
	"schemaVersion": 1,
	"id": "crystal_mod",
	"version": "${version}",
	"name": "Crystal Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Crystal"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/crystal-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.crystal.CrystalMod"
		],
		"client": [
			"com.crystal.CrystalModClient"
		],
		"fabric-datagen": [
			"com.crystal.CrystalModDataGenerator"
		]
	},
	"mixins": [
		"crystal-mod.mixins.json",
		{
			"config": "crystal-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}